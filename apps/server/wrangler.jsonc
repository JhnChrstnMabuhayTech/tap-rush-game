{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glowcatch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      // Players and rounds; the schema is in migrations/. Created with
      // `wrangler d1 create glowcatch` (region APAC).
      "binding": "DB",
      "database_name": "glowcatch",
      "database_id": "f5d36373-6f1d-4b76-a7c7-fe84cb3d4702",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      // Requests to /v1 per client IP. Generous, because players on one mobile
      // network can share an IP; it's there to stop floods, not players.
      "name": "LIMIT_BY_IP",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  // The Facebook App Secret is a secret, never a var here:
  // `wrangler secret put APP_SECRET`. For local development, apps/server/.dev.vars
  // (gitignored) sets APP_SECRET and ALLOW_UNSIGNED.
}
